# Pick My Lunch — environment variables.
# Copy to .env.local (gitignored) for local dev. Production values live in
# Vercel → Settings → Environment Variables. Never ship `.env` to a remote.

# --- Server-only (NO VITE_ prefix, never exposed to the browser) ---
# OpenAI API key used by /api/recommend and /api/recipe.
OPENAI_API_KEY=

# Cloudflare Turnstile secret (paired with the public site key below).
# Get it at https://dash.cloudflare.com → Turnstile → your site.
TURNSTILE_SECRET_KEY=

# Upstash Redis REST credentials for per-IP rate limiting.
# Sign up free at https://console.upstash.com and create a Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated extra origins allowed to call /api/* (e.g. a custom domain).
# The Vercel deployment URL is allowed automatically.
ALLOWED_ORIGINS=

# Optional rate-limit overrides (defaults: 10/min, 100/day per IP).
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=100

# --- Public / client-exposed (must be prefixed with VITE_) ---
# Cloudflare Turnstile site key. Safe to ship to the browser.
VITE_TURNSTILE_SITE_KEY=
